{
  "name": "meteredsignal",
  "private": true,
  "workspaces": [
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "merchant": "npm run dev --workspace=packages/merchant",
    "agent": "npm run dev --workspace=packages/agent",
    "web": "npm run dev --workspace=web",
    "dev": "concurrently --names merchant,agent,web --prefix-colors cyan,magenta,green \"npm run merchant\" \"npm run agent\" \"npm run web\"",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=web",
    "associate": "npm run associate --workspace=scripts",
    "create-topic": "npm run create-topic --workspace=scripts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.81.0"
  }
}
