# --- Hedera x402 (required for merchant + agent payments) ---
HEDERA_SERVICE_ACCOUNT_ID=0.0xx
HEDERA_SERVICE_PRIVATE_KEY=0x...
HEDERA_AGENT_ACCOUNT_ID=0.0xxx
HEDERA_AGENT_PRIVATE_KEY=xxx

# Prefer Blocky402 testnet (Hedera ETHOnline requirement)
X402_TESTNET_FACILITATOR_URL=https://api.testnet.blocky402.com

# --- The Graph (required for live data) ---
GRAPH_API_KEY=xxx

# Freshness: max blocks behind tip before signal is rejected
GRAPH_MAX_BLOCK_LAG=50

# --- Ports ---
MERCHANT_PORT=4021
AGENT_PORT=3001
MERCHANT_URL=http://localhost:4021

# --- Arc Testnet USDC action (optional but needed for Arc track) ---
# Native gas token is USDC (18 decimals). Fund via faucet.circle.com
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_AGENT_PRIVATE_KEY=
ARC_TREASURY_ADDRESS=
ARC_SPEND_AMOUNT_USDC=0.01

# --- HCS audit trail (Hedera extra points) ---
# Create with: npm run create-topic
HEDERA_HCS_TOPIC_ID=
